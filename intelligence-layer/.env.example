# ── LLM Primary (reasoning + tool calls) ─────────────────────────────────────
LLM_PRIMARY_PROVIDER=openai_compat
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_BASE_URL=https://api.cerebras.ai/v1
LLM_PRIMARY_MODEL=zai-glm-4.7
LLM_PRIMARY_TEMPERATURE=0.1
LLM_PRIMARY_MAX_TOKENS=2048

# ── LLM Fast (classify benign/suspicious/threat) ──────────────────────────────
LLM_FAST_PROVIDER=openai_compat
LLM_FAST_API_KEY=
LLM_FAST_BASE_URL=https://api.cerebras.ai/v1
LLM_FAST_MODEL=llama3.1-8b
LLM_FAST_TEMPERATURE=0.0
LLM_FAST_MAX_TOKENS=512

LLM_TIMEOUT_SECONDS=10

# ── Redis (warm cache) ────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Postgres (audit log) ──────────────────────────────────────────────────────
POSTGRES_URL=postgresql+asyncpg://ztuser:ztpass@postgres:5432/zerotrust

# ── ChromaDB (RAG) ────────────────────────────────────────────────────────────
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION_MITRE=mitre_attack
CHROMA_COLLECTION_DECISIONS=past_decisions

# ── IDS Agent (SSE consume + enforcement proxy) ───────────────────────────────
IDS_AGENT_URL=http://ids-agent:8766

# ── Pipeline filters (pre-LLM gate) ──────────────────────────────────────────
FILTER_SEVERITY_MIN=2
FILTER_DEDUP_WINDOW_SECONDS=30
FILTER_RATE_LIMIT_PER_MINUTE=30
FILTER_WHITELIST_IPS=10.10.6.238,192.168.122.20,192.168.122.21

# ── Safety guardrails ─────────────────────────────────────────────────────────
AGENT_DRY_RUN=true
AGENT_CONFIDENCE_AUTO_ENFORCE=0.85
AGENT_CONFIDENCE_NOTIFY=0.70
AGENT_CONFIDENCE_HOLD=0.50
AGENT_SELF_CONSISTENCY_RUNS=3
AGENT_SELF_CONSISTENCY_MIN_AGREE=2

# Blast radius limits (L5)
SAFETY_MAX_RULES_PER_MINUTE=5
SAFETY_MAX_TOTAL_AGENT_RULES=50
SAFETY_MAX_RULES_PER_IP=3
SAFETY_PER_IP_WINDOW_SECONDS=300
SAFETY_TTL_MIN_SECONDS=60
SAFETY_TTL_MAX_SECONDS=3600

# Circuit breaker (L8)
SAFETY_CIRCUIT_FAIL_THRESHOLD=3
SAFETY_CIRCUIT_HALT_SECONDS=300

# ── Enforcement ───────────────────────────────────────────────────────────────
ENFORCEMENT_BACKEND=ids_agent_proxy

# SSH fallback (only if ids_agent_proxy unreachable)
SSH_LEAF1_HOST=192.168.122.20
SSH_LEAF1_USER=admin
SSH_LEAF1_PASSWORD=
SSH_LEAF2_HOST=192.168.122.21
SSH_LEAF2_USER=admin
SSH_LEAF2_PASSWORD=

# ── Observability ─────────────────────────────────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=zerotrust-agent
LOG_LEVEL=INFO
