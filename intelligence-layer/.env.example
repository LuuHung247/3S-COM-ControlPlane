# ── LLM Provider (OpenAI-compatible) ──────────────────────────────────────────
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_PRIMARY=llama-3.3-70b-versatile
LLM_MODEL_FAST=llama-3.1-8b-instant
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=10

# Fallback provider (optional)
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_MODEL=anthropic/claude-sonnet-4-6

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_ALERTS=alerts:incoming
REDIS_STREAM_DECISIONS=decisions:outgoing
REDIS_CACHE_TTL_SECONDS=3600

# ── Postgres ───────────────────────────────────────────────────────────────────
POSTGRES_URL=postgresql+asyncpg://user:pass@localhost:5432/zerotrust

# ── ChromaDB ───────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=mitre_attack

# ── Agent behavior ─────────────────────────────────────────────────────────────
AGENT_CONFIDENCE_THRESHOLD=0.7
AGENT_MAX_RETRIES=2
AGENT_ENABLE_SELF_CONSISTENCY=false

# ── Trigger filters ────────────────────────────────────────────────────────────
FILTER_SEVERITY_MIN=2
FILTER_DEDUP_WINDOW_SECONDS=30
FILTER_RATE_LIMIT_PER_MINUTE=30
FILTER_WHITELIST_IPS=

# ── Enforcement backend ────────────────────────────────────────────────────────
# sf_rest = Secure Framework REST API (primary, persistent)
# ssh     = Direct SSH to LEAF (fallback, dev only)
# mock    = No-op, for testing
ENFORCEMENT_BACKEND=sf_rest

SF_API_URL=http://10.10.6.238:9090
IDS_AGENT_URL=http://localhost:8766

# SSH fallback (only used when ENFORCEMENT_BACKEND=ssh)
SSH_LEAF1_HOST=192.168.122.20
SSH_LEAF1_USER=admin
SSH_LEAF1_KEY_PATH=~/.ssh/leaf_rsa
SSH_LEAF2_HOST=192.168.122.21
SSH_LEAF2_USER=admin
SSH_LEAF2_KEY_PATH=~/.ssh/leaf_rsa

# ── Observability ──────────────────────────────────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=zerotrust-agent
LOG_LEVEL=INFO

# ── Integration với IDS Agent ──────────────────────────────────────────────────
IDS_AGENT_SSE_URL=http://localhost:8766/events
IDS_AGENT_WEBHOOK_URL=http://localhost:8766/autoblock
